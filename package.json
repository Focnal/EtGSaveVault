{
  "name": "etg-save-vault",
  "productName": "EtG Save Vault",
  "version": "0.1.0",
  "private": true,
  "description": "Enter the Gungeon 存档备份管理工具",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "esbuild": "^0.24.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
