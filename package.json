{
  "name": "etg-save-vault",
  "productName": "EtG Save Vault",
  "author": {"name": "focnal", "email": "focnal@foxmail.com"},
  "version": "0.1.0",
  "private": true,
  "description": "Enter the Gungeon 存档备份管理工具",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "make": "npm run build && electron-builder",
    "make:cn": "node scripts/mirror.mjs --timeout=1800 -- npm run make",
    "install:cn": "node scripts/mirror.mjs --timeout=1800 -- npm install"
  },
  "build": {
    "appId": "com.focnal.etgsavevault",
    "productName": "EtG Save Vault",
    "directories": {
      "output": "dist-executable"
    },
    "compression": "normal",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
